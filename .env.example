# ---- Transport -------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp
# Static bearer token required on every MCP request. Strongly recommended.
MCP_AUTH_TOKEN=
# Comma-separated Host allowlist (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=
# Comma-separated Origin allowlist. Once set, a request with NO Origin header is rejected too,
# so leave it empty for non-browser clients such as CLIs.
MCP_ALLOWED_ORIGINS=
# 1 = per-client sessions with Mcp-Session-Id (default). 0 = stateless.
MCP_STATEFUL=1
# Idle seconds before a session is evicted, and the cap on concurrent sessions.
MCP_SESSION_TTL_SECONDS=1800
MCP_MAX_SESSIONS=256
# Largest accepted JSON request body, in bytes.
MCP_MAX_REQUEST_BYTES=4194304
# debug | info | warn | error | silent
LOG_LEVEL=info

# ---- Google credentials: pick ONE ------------------------------------------
# (a) OAuth2 user credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# (b) Service account (optionally impersonating a Workspace user)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
GOOGLE_IMPERSONATE_SUBJECT=

# (c) Application Default Credentials: set nothing above and run `gcloud auth application-default login`

# (d) Per-request tokens: clients send X-Google-Access-Token with each call
GOOGLE_TOKEN_PASSTHROUGH=0

GOOGLE_SCOPES=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/drive.appdata

# ---- Behaviour -------------------------------------------------------------
# 1 = expose only the read-only tools (31, or 28 when local file access is on).
DRIVE_READ_ONLY=0
# 1 = allow media.localPath uploads and destinationPath downloads on the server host.
# This adds destinationPath to the download tools and drops their read-only annotation.
DRIVE_ALLOW_LOCAL_FILES=0
DRIVE_MAX_INLINE_BYTES=8388608
